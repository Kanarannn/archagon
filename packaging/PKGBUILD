
# Maintainer: Archagon
pkgname=archagon
pkgver=0.2.0
pkgrel=1
pkgdesc="Laragon-inspired local development server manager for Arch Linux"
arch=('x86_64')
url="https://github.com/Kanarannn/archagon"
license=('MIT')

depends=(
    'glibc'
    'gcc-libs'
    'gtk3'
    'webkit2gtk-4.1'
    'openssl'
    'libayatana-appindicator'
    'librsvg'

    # Local development stack
    'apache'
    'mariadb'
    'php'
    'php-apache'
    'phpmyadmin'

    # Desktop integration
    'polkit'
    'xdg-utils'
)

makedepends=(
    'git'
    'rust'
    'nodejs'
    'npm'
    'pkgconf'
    'patchelf'
)

optdepends=(
    'kitty: terminal integration'
    'foot: terminal integration'
    'alacritty: terminal integration'
    'konsole: terminal integration'
    'xfce4-terminal: terminal integration'
    'xterm: terminal integration'
)

install=archagon.install

source=(
    "archagon::git+https://github.com/Kanarannn/archagon.git#tag=v${pkgver}"
)

sha256sums=('SKIP')

build() {
    cd "$srcdir/archagon"

    npm ci --no-audit --no-fund

    npm run tauri build -- --no-bundle
}

package() {
    cd "$srcdir/archagon"

    # Application binary
    install -Dm755 \
        src-tauri/target/release/archagon \
        "$pkgdir/usr/bin/archagon"

    # Application icons
    install -Dm644 src-tauri/icons/32x32.png \
        "$pkgdir/usr/share/icons/hicolor/32x32/apps/archagon.png"

    install -Dm644 src-tauri/icons/64x64.png \
        "$pkgdir/usr/share/icons/hicolor/64x64/apps/archagon.png"

    install -Dm644 src-tauri/icons/128x128.png \
        "$pkgdir/usr/share/icons/hicolor/128x128/apps/archagon.png"

    install -Dm644 src-tauri/icons/128x128@2x.png \
        "$pkgdir/usr/share/icons/hicolor/256x256/apps/archagon.png"

    # Desktop entry
    install -Dm644 /dev/stdin \
        "$pkgdir/usr/share/applications/archagon.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=Archagon
GenericName=Local Server Manager
Comment=Local development server manager
Exec=archagon
TryExec=archagon
Icon=archagon
Terminal=false
Categories=Development;WebDevelopment;
Keywords=apache;mariadb;mysql;php;localhost;server;
StartupNotify=true
EOF

    # License
    install -Dm644 LICENSE \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
