{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Archagon",
  "version": "0.2.0",
  "identifier": "dev.archagon.manager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Archagon \u00b7 Server Manager",
        "width": 1000,
        "height": 702,
        "minWidth": 760,
        "minHeight": 650,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://api.github.com; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "targets": [
      "appimage"
    ],
    "category": "Development",
    "shortDescription": "Arch Linux local development server manager",
    "longDescription": "A Laragon-inspired manager for native Apache and MariaDB services."
  }
}
